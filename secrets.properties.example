# Copy to secrets.properties and fill in. That file is gitignored.
# Both values come from the Supabase dashboard under Connect.
# The publishable key is safe in the app -- row-level security protects the
# data. The service role key belongs in neither file, ever.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# The WEB application OAuth client, not the Android one. It is not a secret
# -- it ships in the APK -- but it belongs beside the others.
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
