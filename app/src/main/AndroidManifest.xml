<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Asking Play whether a package has a public listing. HEAD only:
         no response body is read, parsed or stored. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read only: whether a validated connection exists. OneDevs holds
         nothing locally, so an offline app is an empty one pretending. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Android 11 hides installed packages from an app unless it says which ones
      it cares about. These three are named individually rather than asking for
      QUERY_ALL_PACKAGES, which needs a Play policy declaration and would be
      refused for a reason as thin as showing an icon. Listing packages by name
      needs no permission and no justification.
    -->
    <queries>
        <package android:name="cc.devbangs.morpho" />
        <package android:name="com.devbangs.search" />
        <package android:name="com.devbangs.beampad" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!--
      Reading which app was in the foreground, and for how long. Granted by the
      user in Settings rather than by a runtime prompt, and not on Play's
      restricted-permissions list. lint calls it a system permission because it
      is signature-level; the appop is what actually governs it.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OneDevsApplication"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneDevs">

        <!-- AdMob. The ID comes from secrets.properties, or Google's test app
             when it is not set; see app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Initialise and load ads off the main thread, so the first frame
             never waits on the ad SDK. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OneDevs.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
